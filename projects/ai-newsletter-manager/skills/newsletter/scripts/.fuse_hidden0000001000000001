#!/usr/bin/env bash
set -euo pipefail

# Create a new email template in GHL via the Email Builder API.
# Two-step process:
#   1. POST /emails/builder to create the template shell
#   2. POST /emails/builder/data to upload HTML content

: "${GHL_API_KEY:?Missing GHL_API_KEY}"
: "${GHL_LOCATION_ID:?Missing GHL_LOCATION_ID}"
: "${GHL_VERSION:?Missing GHL_VERSION}"

TITLE=""
HTML_FILE=""
HTML_CONTENT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title) TITLE="$2"; shift 2 ;;
    --html-file) HTML_FILE="$2"; shift 2 ;;
    --html) HTML_CONTENT="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$TITLE" ]]; then
  echo "Error: --title is required" >&2
  exit 1
fi

if [[ -z "$HTML_FILE" && -z "$HTML_CONTENT" ]]; then
  echo "Error: --html-file or --html is required" >&2
  exit 1
fi

# Read HTML from file if provided
if [[ -n "$HTML_FILE" ]]; then
  if [[ ! -f "$HTML_FILE" ]]; then
    echo "Error: HTML file not found: $HTML_FILE" >&2
    exit 1
  fi
  HTML_CONTENT=$(cat "$HTML_FILE")
fi

# Step 1: Create the template
echo "Creating template: $TITLE" >&2

CREATE_BODY=$(jq -n \
  --arg locationId "$GHL_LOCATION_ID" \
  --arg title "$TITLE" \
  '{
    locationId: $locationId,
    title: $title,
    editorType: "html"
  }')

RESPONSE=$(curl -s -w "\nHTTP_STATUS:%{http_code}" \
  -X POST "https://services.leadconnectorhq.com/emails/builder" \
  -H "Authorization: Bearer $GHL_API_KEY" \
  -H "Version: $GHL_VERSION" \
  -H "Content-Type: application/json" \
  -d "$CREATE_BODY")

HTTP_STATUS=$(echo "$RESPONSE" | tail -1 | sed 's/HTTP_STATUS://')
BODY=$(echo "$RESPONSE" | sed '$d')

if [[ "$HTTP_STATUS" != "200" && "$HTTP_STATUS" != "201" ]]; then
  echo "Error creating template. HTTP $HTTP_STATUS" >&2
  echo "$BODY" >&2
  exit 1
fi

# Extract template ID (check multiple possible paths)
TEMPLATE_ID=$(echo "$BODY" | jq -r '.id // .templateId // .data.id // empty')

if [[ -z "$TEMPLATE_ID" ]]; then
  echo "Error: Could not extract template ID from response" >&2
  echo "$BODY" >&2
  exit 1
fi

echo "Template created: $TEMPLATE_ID" >&2

# Step 2: Upload HTML content
DATA_BODY=$(jq -n \
  --arg locationId "$GHL_LOCATION_ID" \
  --arg templateId "$TEMPLATE_ID" \
  --arg html "$HTML_CONTENT" \
  '{
    locationId: $locationId,
    templateId: $templateId,
    editorType: "html",
    html: $html
  }')

RESPONSE2=$(curl -s -w "\nHTTP_STATUS:%{http_code}" \
  -X POST "https://services.leadconnectorhq.com/emails/builder/data" \
  -H "Authorization: Bearer $GHL_API_KEY" \
  -H "Version: $GHL_VERSION" \
  -H "Content-Type: application/json" \
  -d "$DATA_BODY")

HTTP_STATUS2=$(echo "$RESPONSE2" | tail -1 | sed 's/HTTP_STATUS://')
BODY2=$(echo "$RESPONSE2" | sed '$d')

if [[ "$HTTP_STATUS2" != "200" && "$HTTP_STATUS2" != "201" ]]; then
  echo "Error uploading HTML content. HTTP $HTTP_STATUS2" >&2
  echo "$BODY2" >&2
  exit 1
fi

echo "HTML content uploaded successfully" >&2
echo "$TEMPLATE_ID"
